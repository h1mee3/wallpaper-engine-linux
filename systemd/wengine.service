[Unit]
Description=Wallpaper Engine Linux Layer (KDE Plasma, Hyprland, Sway, Wayland)
PartOf=graphical-session.target
After=graphical-session.target
After=graphical-session-pre.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wengine daemon
Restart=on-failure
RestartSec=2s
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=5s

[Install]
WantedBy=graphical-session.target
